---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
    {% if links %}
    <ul class="links">
      {% for link in links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}
    </ul>
    {% endif %}
  </header>
  {% if image %}
  <figure class="cover">
    <img src="{{ image }}" alt="{{ imageAlt }}">
    {% if imageAlt %}<figcaption>{{ imageAlt }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="back"><a href="/">All posts</a></p>
</article>
