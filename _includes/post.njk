---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    {% set invNo = 0 %}{% for item in collections.posts %}{% if item.url == page.url %}{% set invNo = loop.index %}{% endif %}{% endfor %}
    <p class="tag-line">
      <span class="inv">No. {{ invNo | pad3 }}</span>
      {% if kind %}<span>{{ kind }}</span>{% endif %}
      {% if status %}<span class="status status-{{ status | slug }}">{{ status }}</span>{% endif %}
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
    </p>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lede">{{ summary }}</p>{% endif %}
    {% if links %}
    <ul class="links">
      {% for link in links %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}
    </ul>
    {% endif %}
  </header>
  {% if image %}
  <figure class="cover">
    <img src="{{ image }}" alt="{{ imageAlt }}">
    {% if imageAlt %}<figcaption>{{ imageAlt }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="back"><a href="/">Back to the inventory</a></p>
</article>
